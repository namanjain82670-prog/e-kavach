{
  "name": "e-kavach-backend",
  "version": "1.0.0",
  "description": "Standalone Node.js/Express backend service for E-KAVACH emergency health access and clinical network",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node src/seeds/seed.js",
    "test": "node --test tests/backend.test.js"
  },
  "keywords": [
    "e-kavach",
    "emergency-healthcare",
    "abha",
    "triage",
    "telemetry",
    "express"
  ],
  "author": "E-KAVACH Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  }
}
