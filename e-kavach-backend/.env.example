# E-KAVACH Backend Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ekavach?schema=public"

# Redis (for OTP cache, rate-limiting, and session management)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_ACCESS_SECRET="ekavach_jwt_access_super_secret_key_32bytes_min_2026"
JWT_REFRESH_SECRET="ekavach_jwt_refresh_super_secret_key_32bytes_min_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# PII Field Encryption (AES-256-GCM / AES-256-CBC)
ENCRYPTION_SECRET_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Frontend Integration
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
CLIENT_APP_URL="http://localhost:3000"

# Storage Configuration (local disk or S3 compatible)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="ekavach-medical-vault"
